# AI Tech Radar Environment Variables Example
# Copy this file to .env and fill in your keys:

# Database & Paths
DB_FILE=data/radar.db
EXPORT_DIR=data/export

# LLM API Keys (Free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LLM Models
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# GitHub API Token (Optional, for higher rate limits on fetch)
GITHUB_API_TOKEN=

# Notifications
# Discord Webhook URL for daily digest notifications:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Log Level: debug | info | warn | error
LOG_LEVEL=info
