{
  "name": "@radar/pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "run": "node --import tsx/esm src/main.ts",
    "db:migrate": "node --import tsx/esm src/cli/db-migrate.ts",
    "db:check": "node --import tsx/esm src/cli/db-check.ts",
    "db:maintain": "node --import tsx/esm src/cli/db-maintain.ts"
  },
  "dependencies": {
    "@radar/core": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
